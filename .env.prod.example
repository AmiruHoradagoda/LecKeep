# Copy to .env.prod (ignored). Supply secrets privately before starting the stack.
APP_DOMAIN=leckeep.example.com
# Defaults to https://APP_DOMAIN. Set explicitly only for a nonstandard HTTPS port.
# PUBLIC_ORIGIN=https://leckeep.example.com
TLS_CERT_DIR=/etc/letsencrypt
HTTP_PORT=80
HTTPS_PORT=443
PROXY_BIND_ADDRESS=0.0.0.0
JWT_SECRET=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET_NAME=leckeep-documents
MINIO_REGION=us-east-1
MONGODB_DATABASE=leckeep
