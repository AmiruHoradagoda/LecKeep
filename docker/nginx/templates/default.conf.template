# Omit query strings from logs: preview URLs contain bearer signatures.
log_format leckeep '$remote_addr [$time_local] "$request_method $uri $server_protocol" $status $body_bytes_sent';
access_log /var/log/nginx/access.log leckeep;
server_tokens off;
resolver 127.0.0.11 valid=10s ipv6=off;
map $args $has_preview_signature {
    default 0;
    "~*(^|&)X-Amz-Signature=[0-9a-f]{64}(&|$)" 1;
}

server {
    listen 80;
    server_name ${APP_DOMAIN};

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/certbot;
        try_files $uri =404;
    }

    location / {
        return 308 ${PUBLIC_ORIGIN}$request_uri;
    }
}

server {
    listen 443 ssl;
    server_name ${APP_DOMAIN};
    ssl_certificate /etc/nginx/tls/live/${APP_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/nginx/tls/live/${APP_DOMAIN}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:SSL:10m;
    ssl_session_tickets off;

    if ($host != ${APP_DOMAIN}) { return 444; }

    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options SAMEORIGIN always;
    add_header Referrer-Policy no-referrer always;
    # Enable HSTS only after the public domain and renewal have been verified.
    client_max_body_size 26m;

    proxy_http_version 1.1;
    proxy_set_header Host $http_host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-Host $http_host;
    proxy_set_header Forwarded "";
    proxy_set_header Connection "";
    proxy_connect_timeout 10s;
    proxy_read_timeout 120s;
    proxy_send_timeout 120s;

    location = /api { return 308 /api/; }
    location ^~ /api/ {
        set $backend_upstream backend:8080;
        proxy_pass http://$backend_upstream$request_uri;
    }

    # Browser previews require signed S3 reads. Do not expose S3 writes or its console.
    location ^~ /${MINIO_BUCKET_NAME}/ {
        limit_except GET { deny all; }
        if ($has_preview_signature = 0) { return 403; }
        access_log off;
        error_log /var/log/nginx/error.log crit;
        set $minio_upstream minio:9000;
        proxy_pass http://$minio_upstream$request_uri;
    }

    location / {
        set $frontend_upstream frontend:80;
        proxy_pass http://$frontend_upstream$request_uri;
    }
}
