# Development placeholders only. Never reuse these values in production.
MONGODB_DATABASE=leckeep
MINIO_ACCESS_KEY=leckeep-local
MINIO_SECRET_KEY=leckeep-local-change-me
MINIO_BUCKET_NAME=leckeep-documents
MINIO_REGION=us-east-1
JWT_SECRET=bGVja2VlcC1kZXZlbG9wbWVudC1vbmx5LWp3dC1zZWNyZXQtMzItYnl0ZXM=

# Host ports avoid the existing Airflow (8080) and AIStor (9000/9001) services.
FRONTEND_PORT=3000
BACKEND_PORT=5050
MINIO_API_PORT=19000
MINIO_CONSOLE_PORT=19001

# Browser-visible URLs use this hostname. Docker service names stay internal.
BROWSER_HOST=localhost
# CORS defaults to the selected browser host/frontend port and 127.0.0.1.
# Optional override, for example:
# CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
